# ==================== 服务配置 ====================

# SD WebUI API 地址
SD_WEBUI_URL=http://127.0.0.1:7860

# Ollama API 地址
OLLAMA_URL=http://127.0.0.1:11434

# Ollama 模型名称
OLLAMA_MODEL=qwen2.5:7b

# Ollama GPU 配置 (0=仅CPU, 1=使用1个GPU, 2=使用2个GPU)
OLLAMA_NUM_GPU=1

# ==================== 生成参数 ====================

# 默认图片尺寸
DEFAULT_WIDTH=512
DEFAULT_HEIGHT=512

# 默认采样步数
DEFAULT_STEPS=30

# 默认 CFG Scale
DEFAULT_CFG_SCALE=7.0

# 生成超时时间 (秒)
GENERATION_TIMEOUT=300

# ==================== Gradio 配置 ====================

# 服务器地址
GRADIO_HOST=127.0.0.1

# 服务器端口
GRADIO_PORT=7861

# 是否创建公共分享链接
GRADIO_SHARE=false

# ==================== 路径配置 ====================

# 输出目录
OUTPUT_DIR=./outputs

# 日志目录
LOG_DIR=./logs

# 字体目录
FONTS_DIR=./assets/fonts

# RAG 持久化目录
RAG_PERSIST_DIR=./data/chroma_db

# ==================== 调试 ====================

# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 是否启用调试模式
DEBUG=false

# ==================== 讯飞语音识别配置 ====================

# 讯飞应用 ID
XUNFEI_APP_ID=

# 讯飞 API Key
XUNFEI_API_KEY=

# 讯飞 API Secret
XUNFEI_API_SECRET=

# 讯飞语音识别 WebSocket URL
# 统一使用多语种大模型服务（支持藏汉混合识别）
XUNFEI_ASR_URL=wss://iat.cn-huabei-1.xf-yun.com/v1

# ==================== 百度语音识别配置（藏语）====================

# 百度语音识别 API Key（用于藏语识别）
BAIDU_ASR_APP_KEY=

# 百度语音识别 Secret Key
BAIDU_ASR_SECRET_KEY=

# ==================== 藏语配置 ====================

# 是否启用藏语功能
TIBETAN_ENABLED=true

# 藏语翻译 API URL
TIBETAN_TRANSLATE_URL=https://fanyi-api.baidu.com/api/trans/vip/translate

# 藏语翻译 APP Key
TIBETAN_APP_KEY=

# 藏语翻译 Secret Key
TIBETAN_SECRET_KEY=

# 藏语识别引擎: xunfei 或 baidu（推荐 baidu）
TIBETAN_ASR_ENGINE=baidu